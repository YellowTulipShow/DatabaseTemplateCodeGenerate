{%- assign db_NotDbName = db.Name | replace: "Db", "" -%}
{% comment %} 常规查询值名称集合 {% endcomment %}
{%- assign QueryListWhereParameterNames = "" -%}
{% comment %} 字典值集合 {% endcomment %}
{%- assign DictionariesNames = "" -%}
{%- for key in table.Fields -%}
{%- assign field = table.Fields[key] -%}
    {%- if field.PrimaryKey == 'True'
        or field.IdentitySign == 'True'
        or field.ViceType == 'image'
        or field.Name == 'AddUserID'
        or field.Name == 'UpdateUserID'
        or field.Name == 'DeleteUserID'
        or field.Name == 'Ordinal' %}
        {%- continue  -%}
    {%- elsif field.ViceType=="Dictionaries" -%}
        {%- assign QueryListWhereParameterNames = QueryListWhereParameterNames | append: "," | append: key -%}
        {%- assign DictionariesNames = DictionariesNames | append: "," | append: key -%}
    {%- else -%}
        {%- assign QueryListWhereParameterNames = QueryListWhereParameterNames | append: "," | append: key -%}
    {%- endif -%}
{% endfor %}
{%- assign QueryListWhereParameterNames = QueryListWhereParameterNames | split: ',' | compact -%}
{%- assign DictionariesNames = DictionariesNames | split: ',' | compact -%}

{%- assign IsHaveUeUploadImg = false -%}
{%- assign IsHaveAddressSet = false -%}
{%- for key in table.Fields -%}
    {%- assign field = table.Fields[key] -%}
    {%- if field.ViceType == "image" -%}
        {%- assign IsHaveUeUploadImg = true -%}
    {%- endif -%}
    {%- if field.Name == "Province"
        or field.Name == "City"
        or field.Name == "Area" -%}
        {%- assign IsHaveAddressSet = true -%}
    {%- endif -%}
{%- endfor -%}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="renderer" content="webkit">
    <meta http-equiv="Cache-Control" content="no-siteapp" />
    <title>{{ table.Explain }} - {{ db.Explain }}</title>
    <!--[if lt IE 9]>
    <meta http-equiv="refresh" content="0;url=/ie.html"/><![endif]-->
    <link rel="shortcut icon" href="/favicon.ico">
    <link href="/Content/css" rel="stylesheet" />
    <link href="/Scripts/jquery-easyui/themes/insdep/css" rel="stylesheet" />
    <link href="/Content/style.min.css" rel="stylesheet" />
    <link href="/Content/OrderCom.css" rel="stylesheet" />

    <script src="/Scripts/jquery"></script>
    <script src="/Scripts/jquery-easyui/jquery.easyui.min.js"></script>
    <script src="/Scripts/jquery-easyui/locale/easyui-lang-zh_CN.js"></script>
    <script src="/Scripts/jquery-easyui/treegrid-dnd.js"></script>
    <script src="/Scripts/js"></script>
    <script src="/Scripts/apiExtend/Api{{ db.Prefix }}.js"></script>

    <script src="/Scripts/ueditor/ueditor.config.js"></script>
    <script src="/Scripts/ueditor/ueditor.all.js"></script>
    <script src="/Scripts/page/extend_tool.js"></script>
    <script src="/Scripts/page/Dialog.js"></script>

    {% if IsHaveUeUploadImg -%}
    <script src="/Scripts/page/htmlShowImg.js"></script>
    <script src="/Scripts/page/UEUpload.js"></script>
    {{ "\n    " }}
    {%- endif -%}

    {%- if IsHaveAddressSet -%}
    <script src="/Scripts/data/city-data.js"></script>
    <script src="/Scripts/data/city-data-use.easyui.combobox.js"></script>
    {{ "\n    " }}
    {%- endif -%}

    <script src="{{ table.Name }}.js"></script>
    <script>
        window.page = new {{ db.Name }}Manage.{{ table.Name }}_ControlManagement({
            datagrid_name: "#datagrid",
            search_form_name: "#search_form",
        });
    </script>
</head>
<body>
    <div class="ibox" style="margin-bottom: 0;">
        <div class="ibox-title">
            <h5></h5>
        </div>
        <div class="ibox-content">
            <div id="search" class="easyui-panel" title="查询条件" iconcls="icon-search" style="margin-bottom: 10px; padding-bottom: 10px;">
                <form id="search_form">
                    {%- for key in QueryListWhereParameterNames -%}
                    {%- assign field = table.Fields[key] -%}
                    {{"\n                    "}}
                    {%- if field.PrimaryKey=='True' or
                        field.IdentitySign=='True' or

                        field.Name == 'AddUserID' or
                        field.Name == 'AddUserName' or
                        field.Name == 'UpdateTime' or
                        field.Name == 'UpdateUserID' or
                        field.Name == 'UpdateUserName' or
                        field.Name == 'DeleteTime' or
                        field.Name == 'DeleteUserName' or
                        field.Name == 'DeleteUserID' -%}
                    {%- continue  -%}

                    {%- elsif field.ViceType == "Dictionaries" -%}
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input name="{{ field.Name }}" type="text" class="easyui-combobox"
                               data-options="
                                editable:false,
                                valueField:'DicValue',
                                textField:'DicKey',
                                url:AdminWebApi{{ db.Prefix }}.{{ db.Prefix }}_SystemSetType.GetSystemSetTypeList.Url,
                                queryParams:{
                                    Remark: '{{ field.Name }}',
                                    EmptyText: '请选择',
                                },
                                method:'get'">
                    </div>

                    {%- elsif field.ViceType == "number" -%}
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <select name="{{ field.Name }}Where" class="easyui-combobox" editable="false" style="width:120px">
                            <option value="0">请选择</option>
                            <option value="1">小于 ' < ' </option>
                            <option value="2">小于等于 ' <= ' </option>
                            <option value="3">等于 ' == ' </option>
                            <option value="4">大于 ' > ' </option>
                            <option value="5">大于等于 ' >= ' </option>
                        </select>
                        -
                        <input name="{{ field.Name }}" type="text" class="easyui-numberbox" data-options="min:0,precision:{%- if field.Type == "int" -%}0{%- else -%}2{%- endif -%}" value="0" style="width:60px" />
                    </div>

                    {%- elsif field.Type == "bool" -%}
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <select name="{{ field.Name }}" class="easyui-combobox" data-options="width:90,">
                            <option value="">请选择</option>
                            <option value="true">是</option>
                            <option value="false">否</option>
                        </select>
                    </div>

                    {%- elsif field.Type == "DateTime" -%}
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input name="{{ field.Name }}Start" class="easyui-datetimebox" data-options="showSeconds:false" />
                        -
                        <input name="{{ field.Name }}End" class="easyui-datetimebox" data-options="showSeconds:false" />
                    </div>

                    {%- else -%}
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input name="{{ field.Name }}" type="text" class="easyui-textbox" />
                    </div>

                    {%- endif -%}
                    {% endfor %}
                    <div class="search_item">
                        <button type="Submit" class="easyui-linkbutton" iconCls="icon-magnifier" style="width:80px;" onclick="return page.Search();">搜索</button>
                    </div>
                    <div class="search_item">
                        <button type="button" class="easyui-linkbutton" iconcls="icon-remove" style="width:120px;" onclick="$(this).parents('form').form('clear');">清除条件</button>
                    </div>
                </form>
            </div>
            <link href="/Scripts/jquery-easyui/plugins_css/jquery.columnMenu.css" rel="stylesheet" />
            <script src="/Scripts/jquery-easyui/plugins/jquery.columnMoving.js" type="text/javascript"></script>
            <script src="/Scripts/jquery-easyui/plugins/jquery.columnMenu.js" type="text/javascript"></script>
            <script type="text/javascript">
                (function () {
                    var cmenu = {};
                    this.ShowDataGridColumnMenu = function (target) {
                        cmenu[target] = window.EasyUI_DataGrid_ColumnMenu_Show(target, cmenu[target]);
                    }
                })();
            </script>
            <div id="toolbar">
                <button class="easyui-linkbutton" iconcls="icon-application_view_columns" onclick="ShowDataGridColumnMenu('#datagrid')">展示/隐藏数据列</button>
                <button class="easyui-linkbutton" plain="true" iconcls="icon-2012092109942" onclick="BaseInfoShowVue('#datagrid', '{{ table.Name }}InfoShowVue.html')">展示详情</button>
                <button class="easyui-linkbutton operating_Add" plain="true" iconcls="icon-add" onclick="page.Create()">添加</button>
                <button class="easyui-linkbutton operating_Edit" plain="true" iconcls="icon-edit" onclick="page.Edit()">修改</button>
                <button class="easyui-linkbutton operating_Delete" plain="true" iconcls="icon-delete" onclick="page.Remove()">删除</button>
            </div>
            <table id="datagrid" title="{{ table.Explain }}" class="easyui-datagrid"
                   toolbar="#toolbar" iconcls="icon-application_view_list"
                   pagination="true" pagesize="20" pagelist="[10,20,30,40,50]" sortname="Id" sortorder="desc"
                   method="post" singleselect="false" fitcolumns="true"
                   data-options="
                    url:AdminWebApi{{ db.Prefix }}.{{ table.Name }}.QueryList.Url,
                    queryParams:page.GetSearchData(),
                    loader: EasyUI_DataGrid_Option_Loader_UseJSONRequestMethod,
                    onDblClickRow:function(){ page.Edit();},
                    onClickRow:function(index, row) { $(this).datagrid('clearSelections');$(this).datagrid('selectRow',index); },
                    onLoadError:function(){ $.messager.alert('提示', '数据查询发生错误!', 'info'); },
                    onLoadSuccess:function(data){ }">
                <thead>
                    <tr>
                        <th field="Check" checkbox="true" width="40"></th>
                        {%- for key in table.Fields -%}
                        {%- assign field = table.Fields[key] -%}
                        {{"\n                        "}}
                        {%- if field.PrimaryKey=='True' or field.IdentitySign=='True' -%}
                        <th field="{{ field.Name }}" width="50" sortable="true">{{ field.Name }}</th>

                        {%- elsif field.ViceType == "image" -%}
                        <th field="{{ field.Name }}" width="100" data-options="formatter:function(val,row){return PicFort(val,row);}">{{ field.Explain }}</th>

                        {%- elsif field.ViceType == "number" -%}
                        <th field="{{ field.Name }}" width="90" sortable="true">{{ field.Explain }}</th>

                        {%- elsif field.ViceType == "ID" -%}
                        <th hidden="hidden" field="{{ field.Name }}" width="80">{{ field.ExplainPrefix }}ID</th>
                        <th field="{{ field.NamePrefix }}Name" width="120">{{ field.ExplainPrefix }}名称</th>

                        {%- elsif field.ViceType == "IDStrings" -%}
                        <th hidden="hidden" field="{{ field.Name }}" width="80">{{ field.ExplainPrefix }}Ids</th>
                        <th field="{{ field.NamePrefix }}Names" width="120">{{ field.ExplainPrefix }}集合</th>

                        {%- elsif field.ViceType == "Dictionaries" -%}
                        <th hidden="hidden" field="{{ field.Name }}" width="80">{{ field.Explain }}ID</th>
                        <th field="{{ field.Name }}Name" width="90">{{ field.Explain }}</th>

                        {%- elsif field.Type == "string" -%}
                        <th field="{{ field.Name }}" width="120">{{ field.Explain }}</th>

                        {%- elsif field.Type == "bool" -%}
                        <th field="{{ field.Name }}" width="80" data-options="formatter:function(val,row){return JSON.parse(val) == true ? '是' : '否';}">{{ field.Explain }}</th>

                        {%- elsif field.Type == "DateTime" -%}
                        <th field="{{ field.Name }}" width="160">{{ field.Explain }}</th>

                        {%- else -%}
                        <th field="{{ field.Name }}" width="100">{{ field.Explain }}</th>
                        {%- endif -%}
                        {% endfor %}
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</body>
</html>
