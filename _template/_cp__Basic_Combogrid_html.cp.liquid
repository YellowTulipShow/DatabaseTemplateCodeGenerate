                <form id="search_form">
                    {%- for key in QueryListWhereParameterNames -%}
                    {%- assign field = table.Fields[key] -%}
                    {{"\n                    "}}
                    {%- if field.ViceType == "Dictionaries" -%}
                    <!-- 单选 : {{ field.Explain }}选择 -->
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input name="{{ field.Name }}" type="text" class="easyui-combobox"
                               data-options="
                                editable:false,
                                valueField:'DicValue',
                                textField:'DicKey',
                                method:'get',
                                url:AdminWebApi{{ db.Prefix }}.{{ db.Prefix }}_SystemSetType.GetSystemSetTypeList.Url,
                                queryParams:{
                                    Remark: '{{ field.Name }}',
                                    EmptyText: '请选择',
                                },">
                    </div>
                    <!-- 多选 : {{ field.Explain }}选择 -->
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input id="search_{{ field.Name }}List" name="{{ field.Name }}List" type="hidden" value="" />
                        <input type="text" class="easyui-combobox"
                               data-options="
                                multiple:true,
                                separator:',',
                                editable:false,
                                valueField:'DicValue',
                                textField:'DicKey',
                                method:'get',
                                url:AdminWebApi{{ db.Prefix }}.{{ db.Prefix }}_SystemSetType.GetSystemSetTypeList.Url,
                                queryParams:{
                                    Remark: '{{ field.Name }}',
                                    EmptyText: '请选择',
                                },
                                onChange:function(newV, oldV){
                                    if (newV) {
                                        $('#search_{{ field.Name }}List').val(newV);
                                    }
                                },">
                    </div>

                    {%- elsif field.ViceType == "ID" -%}
                    <!-- 单选 : {{ field.Explain }}选择 -->
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input type="text" name="{{ field.Name }}" class="easyui-combobox"
                               data-options="
                                editable:false,
                                valueField:'Value',
                                textField:'Text',
                                method:'get',
                                url:AdminWebApi{{ db.Prefix }}.SystemDictionaryEnumeration.GetFullNameEnumValueList.Url,
                                queryParams:{
                                    FullName: 'ErTuiShengShi.Logic.XXX.Enums.E{{ field.Name }}',
                                    ProjectName: 'ErTuiShengShi.Logic',
                                    EmptyText: '请选择',
                                },">
                    </div>
                    <!-- 多选 : {{ field.Explain }}选择 -->
                    <div class="search_item">
                        <label>{{ field.Explain }}:</label>
                        <input id="search_{{ field.Name }}List" name="{{ field.Name }}List" type="hidden" value="" />
                        <input type="text" class="easyui-combobox"
                               data-options="
                                multiple:true,
                                separator:',',
                                editable:false,
                                valueField:'Value',
                                textField:'Text',
                                method:'get',
                                url:AdminWebApi{{ db.Prefix }}.SystemDictionaryEnumeration.GetFullNameEnumValueList.Url,
                                queryParams:{
                                    FullName: 'ErTuiShengShi.Logic.XXX.Enums.E{{ field.Name }}',
                                    ProjectName: 'ErTuiShengShi.Logic',
                                },
                                onChange:function(newV, oldV){
                                    if (newV) {
                                        $('#search_{{ field.Name }}List').val(newV);
                                    }
                                },">
                    </div>

                    {%- else -%}
                    <input name="{{ field.Name }}" type="hidden" value="" />

                    {%- endif -%}
                    {% endfor %}
                </form>





